# Resend (https://resend.com) — used to send demo request notifications and confirmations.
RESEND_API_KEY=

# Verified sender identity, e.g. "Workforce OS <hello@workforceos.com>"
RESEND_FROM_EMAIL=

# Inbox that receives new demo requests.
SALES_INBOX_EMAIL=

# Canonical site URL, used for metadata, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://www.workforceos.com

# Optional analytics provider: "plausible" | "umami" | "gtag". Leave unset to disable.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
