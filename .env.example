# Resend (https://resend.com) — used to send demo request notifications and confirmations.
RESEND_API_KEY=

# Verified sender identity, e.g. "Straw <hello@workforceos.com>"
RESEND_FROM_EMAIL=

# Inbox that receives new demo requests.
SALES_INBOX_EMAIL=

# Canonical site URL, used for metadata, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://www.workforceos.com

# Optional analytics provider: "plausible" | "umami" | "gtag". Leave unset to disable.
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# Optional HTTPS link to the calendar page where visitors choose a demo time.
# Shown only after a demo request is submitted; no form data is added to it.
# Invalid or non-HTTPS values are ignored and the link is not shown.
DEMO_BOOKING_URL=

# Optional HTTPS URL of the existing customer app. When set and valid, the
# header shows a "Log in" link to it. Leave unset to hide login.
NEXT_PUBLIC_APP_URL=
